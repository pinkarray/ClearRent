rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin identity check. Passes if the caller's ID token carries
    // either the admin or superAdmin custom claim. Claims are set via
    // the setAdminClaim Cloud Function (which itself requires superAdmin
    // to invoke). The bootstrap superAdmin is set out-of-band via the
    // local scripts/bootstrap-superadmin.ts script.
    function isAdmin() {
      return (request.auth.token.admin == true)
        || (request.auth.token.superAdmin == true);
    }

    // Super admin identity check. Used by surfaces that should be
    // gated specifically to super admins (e.g. managing other admins).
    // Currently no rules reference this — it's available for Workstream
    // 6 follow-ups and any rule that needs a stricter gate than isAdmin.
    function isSuperAdmin() {
      return (request.auth.token.superAdmin == true);
    }

    // Read-only admin panel access. A `viewer` custom claim grants the admin
    // dashboard the SAME read surface as a full admin, but never write access.
    // Used on READ / GET / LIST clauses only — every create/update/delete gate
    // stays on isAdmin(), so a viewer can look at everything and change nothing.
    function isViewer() {
      return request.auth != null && request.auth.token.viewer == true;
    }

    // Anyone allowed to read admin-gated data: full admins OR read-only viewers.
    function canRead() {
      return isAdmin() || isViewer();
    }

    // Verification gate for the CALLER. Mirrors the client's messaging gate
    // (ConversationService._isUserVerified) so an unverified user can't bypass
    // the app UI and inject messages directly. Reads users/{uid}; guarded with
    // exists() so a missing user doc resolves to "not verified" rather than
    // erroring. Verification is admin-granted (see the users update rule), so
    // this cannot be self-satisfied.
    function isVerified() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('verificationStatus', 'none') == 'verified';
    }

    // Internal — locked. Only Cloud Functions (admin SDK) write here.
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Platform config, currently the pricing schedule (config/pricing).
    // Readable by any signed-in user so the app can DISPLAY current fees;
    // writable only by admins. The server independently derives what it
    // actually charges from this same document (functions/src/pricing.ts),
    // so the client copy is display-only and is never trusted for money.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // The minimum-supported-build gate. Read publicly because it has to work
    // on the sign-in screen too: a user stuck on a build we've retired is
    // often the user who cannot get past login, and the generic config rule
    // above requires auth. Holds a build number, a message and a store URL —
    // nothing private. Writes stay admin-only via that same rule.
    match /config/app_version {
      allow read: if true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // Phone-to-email lookup at sign-in goes through the
      // lookupEmailByPhone Cloud Function, which uses admin SDK
      // (bypasses rules). Clients must be authenticated to list users.
      allow list: if request.auth != null;
      
      // Create own doc at signup. May NOT self-assign verified/privileged
      // state: verification is admin-granted (isAdmin clause below), earnings
      // are Cloud-Function-only. Closes the self-verify bypass (audit #1) at
      // the create path.
      allow create: if request.auth != null && request.auth.uid == userId
        && !(request.resource.data.get('verificationStatus', 'none')
              in ['verified', 'rejected'])
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('pendingEarnings', 0) == 0
        && request.resource.data.get('paidEarnings', 0) == 0
        && !('verificationExempt' in request.resource.data);

      // Owner self-update, EXCEPT server-authoritative fields:
      //  - verificationStatus may be set to a non-approved value (e.g.
      //    'pending' on verification submit) but NEVER 'verified'/'rejected'
      //    — those are admin-only (isAdmin clause below). This is the fix for
      //    audit #1: previously the blanket owner-update let a modified client
      //    self-set verificationStatus='verified' and then list properties
      //    (the properties/create rule reads this field as source of truth)
      //    without paying the fee or passing admin review.
      //  - isVerified can't be self-set true (same gate, mirror field).
      //  - pendingEarnings/paidEarnings/verificationExempt are written only by
      //    Cloud Functions via the admin SDK (which bypasses these rules).
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['pendingEarnings', 'paidEarnings', 'verificationExempt',
                       'rating', 'ratingRaw', 'totalRatings'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['verificationStatus'])
          || !(request.resource.data.verificationStatus in ['verified', 'rejected'])
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['isVerified'])
          || request.resource.data.isVerified == false
        );

      // Admin can update any user doc (approve/reject verification, etc.).
      allow update: if isAdmin();

      // rating / ratingRaw / totalRatings are written ONLY by the
      // onInspectionRated Cloud Function (admin SDK, bypasses rules). No client
      // clause — this closes audit #2 (previously any authed user could set
      // another user's rating). They're also in the owner blocklist above.

      // Earnings fields (pendingEarnings, paidEarnings) are written
      // exclusively by Cloud Functions using admin SDK — the W1
      // creditInspectionEarnings CF credits, the W5 markInspection
      // AgentPayoutPaid CF shifts pending→paid. Admin SDK bypasses
      // these rules, so no allow-update clause is needed for them.

      // Saved properties subcollection
      match /savedProperties/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Private subcollection (C1) — sensitive data that must NOT live on the
      // user doc (which is readable by any authenticated user). Holds
      // `private/bank` (account number/name/bank). Readable only by the owner
      // and admin (payout pages); writable only by the owner. Cloud Functions
      // use the admin SDK and bypass these rules.
      match /private/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || canRead()
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Verification requests collection. Highly sensitive — contains NIN
    // URLs, utility bills, and payment references. Closes F1.9 (previously
    // any authenticated user could read every verification request).
    match /verification_requests/{requestId} {
      // Create: any authenticated user can submit their own verification
      // request, and the userId on the doc must be themselves (closes a
      // would-be vector where a fraudster submits a verification request
      // pointing at someone else's docs).
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Get/read: only the submitter or admin.
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        canRead()
      );

      // List/query: same ownership constraint. The only caller today is
      // verification_service line ~433, which queries the submitter's
      // own requests. Admin webapp doesn't query this collection
      // (verification status is mirrored on the users doc instead).
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        canRead()
      );

      // Update: admin only (status transitions: pending → verified/rejected).
      allow update: if isAdmin();

      // No deletes from clients.
      allow delete: if false;
    }
    
    // Properties collection
    match /properties/{propertyId} {
      allow read: if request.auth != null;

      // A unit may only reference a building the SAME landlord owns — otherwise
      // a modified client could borrow another owner's verified C of O by
      // setting their buildingId. True when no building is referenced.
      function buildingOwnedByCaller() {
        return !('buildingId' in request.resource.data)
          || request.resource.data.buildingId == null
          || (
            exists(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId))
            && get(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId)).data.landlordId == request.auth.uid
          );
      }

      // True when this write attaches the listing to a building (a "grouped
      // unit"). Such a unit owns NO document of its own — the building's C of O
      // is the single artifact an admin reviews, and the unit inherits it.
      function isGrouped() {
        return 'buildingId' in request.resource.data
          && request.resource.data.buildingId != null;
      }

      // Statuses an OWNER may write. 'verified'/'rejected' are the admin's
      // verdict and are absent by construction. Written as an allowlist: a
      // denylist of ['verified','rejected'] let 'inherited' (grouped units) and
      // 'not_uploaded' (add-property) walk through every guard below.
      function ownerDocStatus(s) {
        return s in ['none', 'not_uploaded', 'pending', 'inherited'];
      }

      function docFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownershipDocUrl', 'ownershipDocType']);
      }

      function changed(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
      }

      // Create: must self-assign ownership AND be a verified landlord.
      // The get() reads the user doc (source of truth) rather than the
      // client-supplied isVerified field, which a modified client could fake.
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified'
        && buildingOwnedByCaller()
        // A listing is BORN unreviewed. Without this the owner-update guards
        // below are decoration: a modified client could simply CREATE the
        // listing already 'verified' with isVerified true and never face an
        // admin at all. isVerified is the admin's badge (adminReviewPropertyDoc
        // writes it), not a mirror of the landlord's own verification.
        && request.resource.data.get('isVerified', false) == false
        && ownerDocStatus(request.resource.data.get('ownershipDocStatus', 'none'))
        // The rejection reason is the admin's words — never seeded by the owner.
        && !request.resource.data.keys().hasAny(['ownershipDocRejectionReason'])
        // A grouped unit carries no doc fields; a standalone listing has no
        // building to inherit from, so it may not claim 'inherited'.
        && (
          isGrouped()
            ? (request.resource.data.get('ownershipDocStatus', 'none') == 'inherited'
                && !request.resource.data.keys().hasAny(['ownershipDocUrl', 'ownershipDocType']))
            : request.resource.data.get('ownershipDocStatus', 'none') != 'inherited'
        );

      // Update: owner can edit own listing, but cannot reassign
      // ownership (closes listing-hijack via landlordId rewrite) and cannot
      // attach a building they don't own.
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.landlordId == resource.data.landlordId
        && buildingOwnedByCaller()
        // buildingId is FIXED at creation. A grouped unit's doc status resolves
        // to its building's, so a mutable buildingId is a skeleton key: attach a
        // rejected listing to any building you own that's already approved and
        // it silently reads as verified, with no admin ever tying that unit to
        // that building. Mis-picked the building? Delete and re-add the listing.
        && request.resource.data.get('buildingId', null)
             == resource.data.get('buildingId', null)
        // isVerified is the admin's badge (adminReviewPropertyDoc writes it) and
        // is immutable for the owner. The create rule pins it false at birth.
        && !changed(['isVerified'])
        // Occupancy is server-owned. recomputePropertyOccupancy derives these
        // from tenancy_links + active_rentals and is the ONLY writer; the app
        // deliberately writes neither (_updatePropertyStatus is empty), and
        // they were nonetheless owner-writable.
        && !changed(['currentTenantsCount', 'handoverPending'])
        // The landlord may still delist or relist at will — that toggle is
        // theirs and the web listing editor writes it. What they may NOT do is
        // relist a unit whose handover is unsettled: ClearRent never holds the
        // caution deposit, so relisting is the only leverage that makes a
        // landlord settle up, and it was bypassable in a single write.
        && (
          !changed(['isAvailable'])
          || resource.data.get('handoverPending', false) == false
        )
        // The rejection reason is the admin's words. The owner may not rewrite
        // or clear it to hide why they were turned down.
        && !changed(['ownershipDocRejectionReason'])
        // Owner may move the doc back to review but may NOT self-verify or
        // self-reject — those are admin-only (the admin clause below bypasses
        // this). Allowlisted, so 'inherited'/'not_uploaded' can't slip past.
        && (
          !changed(['ownershipDocStatus'])
          || ownerDocStatus(request.resource.data.get('ownershipDocStatus', 'none'))
        )
        // A standalone listing has no building to inherit from. Enforced at
        // create; it must hold on UPDATE too. Otherwise an owner creates
        // legitimately, gets REJECTED by an admin, then relabels the status to
        // 'inherited' — which is in the owner allowlist, leaves buildingId and
        // isVerified untouched, and resolves (standalone) to its own raw value,
        // so every status-keyed gate downstream passes trivially and the
        // rejection is escaped.
        && (
          isGrouped()
          || request.resource.data.get('ownershipDocStatus', 'none') != 'inherited'
        )
        // A grouped unit owns no document — the building's is the reviewed
        // artifact. Its own doc fields must never be written: with status
        // 'inherited' (never the literal 'verified') every status-keyed guard
        // below passes trivially, which is how a unit came to be labelled
        // 'c_of_o' under a building the admin approved as a 'deed'.
        && (!isGrouped() || !docFieldsChanged())
        // Changing the DOCUMENT ITSELF (file or type) must send it back for
        // review. Keyed on the FIELD changing, not on the current status, so an
        // owner can't swap the file and keep an approval the admin never gave to
        // that document.
        && (
          !docFieldsChanged()
          || request.resource.data.get('ownershipDocStatus', 'none') == 'pending'
        )
        // Once an admin has APPROVED the document, its type can't be relabelled
        // on its own — the file is whatever it is, so calling an approved C of O
        // a 'deed' just makes the record lie. Changing the type after approval
        // requires uploading the matching document. Before review (pending /
        // none / rejected) the owner is still free to correct the label.
        && (
          !changed(['ownershipDocType'])
          || resource.data.get('ownershipDocStatus', 'none') != 'verified'
          || changed(['ownershipDocUrl'])
        )
        && (
          (resource.data.get('currentTenantsCount', 0) <= 0)
          || (
            request.resource.data.rent == resource.data.rent
            && request.resource.data.agentFee == resource.data.agentFee
            && request.resource.data.cautionDeposit == resource.data.cautionDeposit
            // Refundability is part of the deal the sitting tenant accepted, so
            // it is frozen alongside the amount. get() with a default because
            // listings created before this field exists don't carry it.
            && request.resource.data.get('cautionDepositRefundable', true)
               == resource.data.get('cautionDepositRefundable', true)
          )
        );

      // Admin override for verification/availability updates from
      // the Next.js admin dashboard.
      allow update: if isAdmin();

      // Readiness gate (Phase 2): the assigned agent may set ONLY the readiness
      // attestation on a property they handle. They don't own the doc, so the
      // owner-update rule above doesn't cover them. Field-scoped so nothing
      // else (rent, ownership, availability) can change through this clause.
      // The landlord's self-handled path rides the owner-update rule.
      allow update: if request.auth != null
        && resource.data.assignedAgentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readyForInspections', 'readinessCheckedAt',
                    'readinessCheckedBy', 'readinessChecklist', 'updatedAt']);

      // The assigned agent also handles inspection scheduling, so they may set
      // ONLY the inspection-availability fields on a property they handle.
      // Field-scoped, same as the readiness clause — nothing else can change.
      allow update: if request.auth != null
        && resource.data.assignedAgentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['inspectionDays', 'inspectionTimeSlots', 'updatedAt']);

      // Any authenticated user can update the engagement counters
      // (inquiryCount, viewCount, savedCount) on a property they
      // don't own. These are bumped by non-owners during normal use:
      // viewCount on open, savedCount on save/unsave, inquiryCount on
      // inspection request. Field-scoped — only these three keys may
      // change through this clause, so ownership-sensitive fields
      // (rent, landlordId, isAvailable, etc.) remain protected.
      // Values are not delta-checked: these are cosmetic metrics and
      // delta enforcement added fragility without protecting anything
      // of value. (Reviewed and chosen deliberately, not an oversight.)
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['inquiryCount', 'viewCount', 'savedCount']);

      // Delete: owner or admin
      allow delete: if request.auth != null
        && resource.data.landlordId == request.auth.uid;
      allow delete: if isAdmin();

      // ── Reveal-on-approval: gated exact location ──────────────────────────
      // The exact street address + precise coordinates live in a `private`
      // subdoc, NOT on the world-readable parent. A browsing tenant sees only
      // the area-level city/state/lga; the exact address is revealed once the
      // handler approves that tenant's inspection (a `reveals/{tenantId}` grant
      // is written on approval).
      function propertyOwner() {
        return get(/databases/$(database)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid;
      }
      function propertyAgent() {
        return get(/databases/$(database)/documents/properties/$(propertyId))
          .data.get('assignedAgentId', '') == request.auth.uid;
      }

      // The landlord's blank tenancy agreement for this unit, uploaded ahead of
      // any tenant so acceptance can attach it automatically.
      //
      // Deliberately NOT covered by the private/{docId} rule below: that one
      // also admits a tenant holding a location reveal grant, and a reveal is
      // about finding the property, not about reading the owner's documents.
      // A tenant receives the agreement when it is copied onto their rental,
      // where getSignedAgreementUrl checks membership.
      match /private/agreement {
        allow read: if request.auth != null && (
          canRead() || propertyOwner() || propertyAgent()
        );
        allow write: if request.auth != null
          && (propertyOwner() || propertyAgent());
      }

      match /private/{docId} {
        // Owner, assigned agent, admin, or a tenant with a reveal grant.
        //
        // The reveal clause explicitly excludes `agreement`. Rules are ORed
        // across every matching path, so the tighter match above cannot
        // subtract access this one grants — without the docId guard, a reveal
        // (which is about finding the property) would also open the landlord's
        // tenancy agreement. Proven by verify_message_rules.js.
        allow read: if request.auth != null && (
          canRead()
          || propertyOwner()
          || propertyAgent()
          || (docId != 'agreement'
              && exists(/databases/$(database)/documents/properties/$(propertyId)/reveals/$(request.auth.uid)))
        );
        // Only the handler (owner or assigned agent) can write the exact
        // location. Requires the parent to already exist (created first).
        allow write: if request.auth != null
          && (propertyOwner() || propertyAgent());
      }

      match /reveals/{tenantId} {
        // The tenant themselves, the handler, or an admin may read a grant.
        allow read: if request.auth != null && (
          canRead()
          || request.auth.uid == tenantId
          || propertyOwner()
          || propertyAgent()
        );
        // Only the handler grants a reveal (on approving an inspection).
        allow create, update: if request.auth != null
          && (propertyOwner() || propertyAgent());
      }
    }

    // Buildings — group multiple unit listings of one landlord so a single
    // ownership document (C of O / deed) is verified ONCE and covers every
    // unit. Units reference buildingId and inherit the building's
    // ownershipDocStatus. A standalone listing has no building.
    match /buildings/{buildingId} {
      // Landlord creates their own building; the doc must start unverified
      // (can't self-assign 'verified'/'rejected').
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && (request.resource.data.ownershipDocStatus == 'none'
            || request.resource.data.ownershipDocStatus == 'pending');

      // Readable by any authenticated user — a prospective tenant viewing a
      // unit needs the building's doc status for the inspection gate (mirrors
      // properties being readable; the C of O URL is no more sensitive than the
      // per-property ownershipDocUrl already is).
      allow get: if request.auth != null;

      // List: the owner (add-property "join a building" picker) or admin (the
      // grouped approval queue). Ownership-constrained to satisfy query safety.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid || canRead()
      );

      // Admin verifies / rejects the shared ownership doc.
      allow update: if isAdmin();

      // Owner may edit building details and (re)upload the doc, but may NOT
      // self-verify: ownershipDocStatus may only be set to 'pending' (resubmit
      // after rejection), never 'verified'/'rejected', and the rejection reason
      // is admin-only. landlordId is immutable.
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.landlordId == resource.data.landlordId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'address', 'ownershipDocUrl', 'ownershipDocType',
              'ownershipDocStatus', 'updatedAt',
            ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownershipDocStatus'])
          || request.resource.data.ownershipDocStatus == 'pending'
        )
        // Changing the DOCUMENT ITSELF (file or type) must send it back for
        // review. Without this, the status guard above only bites when status
        // is among the changed keys — so an owner could swap the file, or
        // relabel c_of_o → deed, while 'verified' silently stuck, keeping an
        // approval the admin never gave to that document.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownershipDocUrl', 'ownershipDocType'])
          || request.resource.data.ownershipDocStatus == 'pending'
        )
        // After review, the type can't be relabelled on its own — changing it
        // requires uploading the matching document. Mirrors properties.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownershipDocType'])
          || resource.data.get('ownershipDocStatus', 'none') != 'verified'
          || request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownershipDocUrl'])
        );

      // No client deletes — a building may have units; admin SDK handles cleanup.
      allow delete: if isAdmin();
    }

    // Conversations collection - FIXED query permissions
    match /conversations/{conversationId} {
      
      // Helper: user is an active participant (not removed)
      function isActiveParticipant() {
        return request.auth.uid in resource.data.participants
          && (
            !('removedParticipants' in resource.data) 
            || !(request.auth.uid in resource.data.removedParticipants)
          );
      }
      
      // Get single doc: only active participants and admin
      allow get: if request.auth != null && (
        isActiveParticipant() || canRead()
      );
      
      // List/query (M3): the caller must be a party to every matched doc —
      // a participant, or the landlord/tenant/agent named on it, or admin.
      // Hardened: was `if request.auth != null`, which let any authed user
      // enumerate every conversation. Live queries scope by
      // `participants array-contains uid` (inbox + the agent-path dedup) or by
      // landlordId/tenantId/agentId == uid (the party-initiated dedup checks).
      allow list: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        canRead()
      );
      
      // Create: user must be in the participants list they're creating
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Update: active participants and admin
      allow update: if request.auth != null && (
        isActiveParticipant() || canRead()
      );
      
      // Delete: admin only
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.participants
            && resource.data.lastMessage == '');
      
      // Messages subcollection
      match /messages/{messageId} {
        // Helper: check parent conversation for active participation
        function isConversationParticipant() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return request.auth.uid in conv.participants
            && (
              !('removedParticipants' in conv) 
              || !(request.auth.uid in conv.removedParticipants)
            );
        }
        
        // Read: active participants and admin
        allow read: if request.auth != null && (
          isConversationParticipant() || canRead()
        );
        
        // Create: active participant, and either (a) they are the sender AND
        // verified (or an admin — admin support messages unverified users), OR
        // (b) it's a system status message they're inserting. The isVerified()
        // clause is the server-side half of the messaging gate that was
        // previously enforced only in the client (audit #5).
        allow create: if request.auth != null &&
          isConversationParticipant() && (
            (request.resource.data.senderId == request.auth.uid
              && (isVerified() || isAdmin())) ||
            request.resource.data.senderId == 'system'
          );
        
        // Which fields this update actually touches.
        function touched() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // Caller wrote this message.
        function isMessageAuthor() {
          return resource.data.senderId == request.auth.uid;
        }

        // Read receipt: flips isRead and NOTHING else, only ever to true, and
        // only on a message someone ELSE sent. You receipt what you read; a
        // sender receipting their own message would be forging the second tick.
        // Mirrors markConversationAsRead, which skips the caller's own docs.
        function isReadReceipt() {
          return touched().hasOnly(['isRead'])
            && request.resource.data.isRead == true
            && resource.data.senderId != request.auth.uid;
        }

        // Edit: the author rewrites their own text. A deleted message stays
        // deleted, and the text must remain non-empty — an "edit" to '' would
        // be a delete that skips the deleted flag.
        function isAuthorEdit() {
          return isMessageAuthor()
            && resource.data.get('deleted', false) == false
            && touched().hasOnly(['text', 'editedAt', 'mentions'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
        }

        // Delete: soft, author only, and it must blank the text. The bubble
        // renders "message deleted" off the flag; leaving the text behind
        // would make the delete cosmetic.
        function isAuthorDelete() {
          return isMessageAuthor()
            && touched().hasOnly(['text', 'deleted', 'deletedAt', 'mentions'])
            && request.resource.data.deleted == true
            && request.resource.data.text == '';
        }

        // Update: a strict allowlist, not blanket participant write. Blanket
        // update let ANY participant rewrite ANY message on the thread —
        // including the other party's — so edit/delete had to close that at
        // the same time it opened. senderId, senderName, timestamp and the
        // property-share snapshot are unreachable from every branch.
        allow update: if request.auth != null
          && isConversationParticipant()
          && (isReadReceipt() || isAuthorEdit() || isAuthorDelete());

        // Deletes are soft (see isAuthorDelete) so the thread keeps its shape.
        allow delete: if false;
      }
    }
    
    // Activities collection
    match /activities/{activityId} {
      // Read/list (M1): the landlord whose feed it is, the actor who generated
      // it, or admin. Hardened — was `if request.auth != null`, which let any
      // authed user enumerate the entire activity feed (who viewed/inquired on
      // which property, landlord ids, payment events). Live queries scope by
      // landlordId == uid (the landlord's feed) or actorId == uid (the
      // view/inquiry dedup checks). landlordId is checked first so the feed
      // query short-circuits before touching actorId (absent on some docs).
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.actorId == request.auth.uid ||
        canRead()
      );

      // Create: any authed user logs an activity. The actor/landlord shapes
      // vary across call sites (some omit actorId), and the sensitive exposure
      // was the read above — so create stays auth-gated, not field-constrained.
      allow create: if request.auth != null;

      // Update (M1): only the feed owner, and only to mark an item read
      // (markAsRead — the sole update site, activity_service.dart).
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead']);
    }
    
    // Saved properties (top-level) — DEAD COLLECTION.
    // The mobile app uses the per-user /users/{userId}/savedProperties
    // subcollection. No code reads or writes this top-level collection
    // (verified via grep across Flutter app, Next.js webapp, and CFs).
    // Locked down to prevent any future accidental writes from being
    // readable by other users. Closes F1.10.
    match /saved_properties/{docId} {
      allow read, write: if false;
    }
    
    // Inspection requests collection.
    //
    // Update rules form a state-machine field lockdown (closes F1.6
    // and F1.12). Each allow-update clause maps to exactly one update
    // site in mobile/inspection_service.dart. Clauses enforce:
    //   - WHO (role check via helper functions)
    //   - WHAT (hasOnly() limits which fields can be touched)
    //   - WHEN (status preconditions, where the operation only makes
    //     sense at a specific point in the lifecycle)
    //
    // Time-based preconditions (reschedule window, on-the-way cutoff
    // 2hrs before scheduled time) are intentionally NOT enforced in
    // rules — product logic, not security.
    match /inspection_requests/{requestId} {
      
      // ─── Helpers ─────────────────────────────────────────────
      
      // Handler = whoever is conducting the inspection. Agent if
      // assigned, else landlord (self-handled).
      function isHandler() {
        return (resource.data.agentId != null
                && resource.data.agentId == request.auth.uid)
          || (resource.data.agentId == null
                && resource.data.landlordId == request.auth.uid);
      }
      
      function isTenant() {
        return resource.data.tenantId == request.auth.uid;
      }
      
      function isLandlord() {
        return resource.data.landlordId == request.auth.uid;
      }
      
      function isAgent() {
        return resource.data.agentId != null
          && resource.data.agentId == request.auth.uid;
      }
      
      // Convenience wrapper for the hasOnly() check.
      function inspFields(fields) {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(fields);
      }
      
      // Receiver of the current reschedule proposal — i.e. the
      // opposite side from whoever proposed it. Used by row 17, 18,
      // 19 (counter, approve, decline of an existing proposal).
      function isRescheduleReceiver() {
        return 'rescheduleProposal' in resource.data
          && resource.data.rescheduleProposal != null
          && resource.data.rescheduleProposal.proposedByUserId
             != request.auth.uid
          && (isTenant() || isAgent() || isLandlord());
      }
      
      // The acting user has a payout account on file. Required to request
      // (tenant) or accept (handler) an inspection so any dispute refund/payout
      // has a destination admin can settle to. Mirrors the client gate in
      // bank_details_gate.dart + request_inspection_sheet.dart. Missing flag
      // (legacy docs) reads as false.
      function actorHasBankDetails() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('hasBankDetails', false) == true;
      }

      // Readiness gate (Phase 2): a property is only bookable once its handler
      // has vetted it. Missing/false ⇒ not bookable (legacy properties must be
      // vetted first). Mirrors the client gate in request_inspection_sheet.
      function propertyIsReady() {
        return exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
          && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
            .data.get('readyForInspections', false) == true;
      }

      // Arrival may only be recorded around the scheduled slot — and since
      // 'confirm met' requires both arrived, and completion requires both
      // confirmed, gating arrival gates the whole chain. Compares absolute
      // instants, so it is timezone-proof: 6h before the slot to 24h after.
      // Without this a Sunday visitor could mark arrived, confirm met and
      // complete a Monday inspection, putting a visit that never happened on
      // the record that backs the handler's payout. Strict on a missing
      // field: an inspection with no date cannot be proven to be happening.
      function withinInspectionWindow() {
        return 'requestedDate' in resource.data
          && resource.data.requestedDate is timestamp
          && request.time > resource.data.requestedDate - duration.value(6, 'h')
          && request.time < resource.data.requestedDate + duration.value(24, 'h');
      }

      // ─── Create / read / list / delete ───────────────────────

      allow create: if request.auth != null && actorHasBankDetails()
        && propertyIsReady();
      
      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        canRead()
      );

      // List/query: a party to the inspection (tenant/landlord/agent), or
      // admin. Hardened (H1): was `if request.auth != null`, which let any
      // authed user enumerate every inspection request. Every live client
      // query scopes by tenantId/landlordId/agentId == uid.
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        canRead()
      );

      allow delete: if false;
      
      // ─── State-machine updates (closes F1.6 + F1.12) ─────────
      
      // [Row 14a] Handler approves request (normal).
      // Site: inspection_service.dart:627
      allow update: if isHandler()
        && actorHasBankDetails()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification')
        && request.resource.data.status == 'approved'
        && inspFields(['status', 'updatedAt']);

      // [Row 14b] Landlord overrides agent decline by approving.
      // Site: inspection_service.dart:627 (override branch)
      allow update: if isLandlord()
        && actorHasBankDetails()
        && resource.data.status == 'declinedByAgent'
        && request.resource.data.status == 'approved'
        && inspFields(['status', 'updatedAt',
                       'wasOverridden', 'overriddenBy']);
      
      // [Row 1] Agent declines request.
      // Site: inspection_service.dart:751
      allow update: if isAgent()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification')
        && request.resource.data.status == 'declinedByAgent'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'landlordOverrideDeadline',
                       'originalDeclineBy', 'updatedAt']);
      
      // [Row 2] finalDeclineRequest — auto-decline after 12hr
      // deadline. No mobile clause. Will be CF-only when implemented
      // (see parking lot). Admin SDK bypasses these rules.
      
      // [Row 3] Landlord declines (initial or override).
      // Site: inspection_service.dart:854
      allow update: if isLandlord()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification'
            || resource.data.status == 'approved')
        && request.resource.data.status == 'declined'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'wasOverridden', 'overriddenBy',
                       'updatedAt']);
      
      // [Row 4] Tenant marks themselves arrived.
      // Site: inspection_service.dart:907
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && withinInspectionWindow()
        && inspFields(['tenantArrived', 'tenantArrivedAt', 'updatedAt']);

      // [Row 5] Handler marks themselves arrived.
      // Site: inspection_service.dart:961
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && withinInspectionWindow()
        && inspFields(['handlerArrived', 'handlerArrivedAt', 'updatedAt']);
      
      // [Row 6] Handler marks inspection complete. Triggers W1
      // creditInspectionEarnings CF. A meeting requires BOTH halves, so the
      // handler can't complete until the tenant has also confirmed.
      // Defensive: the flags may be absent on legacy/test docs; use `in`.
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && 'tenantConfirmedMet' in resource.data
        && resource.data.tenantConfirmedMet == true
        && 'handlerConfirmedMet' in resource.data
        && resource.data.handlerConfirmedMet == true
        && request.resource.data.status == 'completed'
        && inspFields(['status', 'completedAt', 'agentPayoutStatus',
                       'completedBy', 'completedByType', 'updatedAt']);
      
      // [Row 7] Tenant rates the inspection post-completion.
      // Site: inspection_service.dart:1129
      // Note: tenantRated field may be absent on never-rated docs.
      // Use `in` check to avoid evaluation error on missing field.
      allow update: if isTenant()
        && resource.data.status == 'completed'
        && (!('tenantRated' in resource.data)
            || resource.data.tenantRated != true)
        && inspFields(['tenantRating', 'tenantReview', 'tenantRated',
                       'ratingSubmittedAt', 'ratedUserId',
                       'ratedUserType', 'ratedUserName', 'updatedAt']);

      // [Row 8] Tenant cancels their unpaid inspection request.
      // Site: inspection_service.dart:1271
      allow update: if isTenant()
        && resource.data.status == 'pendingPayment'
        && request.resource.data.status == 'cancelled'
        && inspFields(['status', 'updatedAt']);
      
      // [Row 9] _processRefund — subroutine called after a paid
      // inspection is declined or cancelled. Inherits caller's auth.
      // Site: inspection_service.dart:2103
      allow update: if (isLandlord() || isTenant() || isHandler())
        && resource.data.paymentStatus == 'paid'
        && request.resource.data.paymentStatus == 'refunded'
        && inspFields(['paymentStatus', 'refundedAt', 'refundReason']);
      
      // [Row 10] Admin verifies payment.
      // Site: inspection_service.dart:2164
      allow update: if isAdmin()
        && resource.data.status == 'pendingPayment'
        && inspFields(['paymentStatus', 'paymentVerifiedAt',
                       'paymentVerifiedBy', 'paidAt', 'status',
                       'updatedAt']);
      
      // [Row 11] Admin rejects payment.
      // Site: inspection_service.dart:2232
      allow update: if isAdmin()
        && resource.data.status == 'pendingPayment'
        && inspFields(['paymentStatus', 'status', 'declineReason',
                       'updatedAt']);
            
      // [Row 13] Handler confirms they received payment.
      // Site: inspection_service.dart:2408
      allow update: if isHandler()
        && resource.data.agentPayoutStatus == 'paid'
        && inspFields(['agentConfirmedPayment', 'agentConfirmedAt',
                       'updatedAt']);
      
      // [Row 15a] Tenant records THEIR half of the meeting. Both must have
      // arrived, and the tenant may only set their own flag — the rule's
      // field allow-list makes it impossible to also flip the handler's.
      // Site: inspection_service.dart markMet
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && resource.data.tenantArrived == true
        && resource.data.handlerArrived == true
        && request.resource.data.tenantConfirmedMet == true
        && inspFields(['tenantConfirmedMet', 'tenantConfirmedMetAt',
                       'updatedAt']);

      // [Row 15b] Handler records THEIR half of the meeting. Same both-arrived
      // gate; can only set the handler's own flag.
      // Site: inspection_service.dart markMet
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && resource.data.tenantArrived == true
        && resource.data.handlerArrived == true
        && request.resource.data.handlerConfirmedMet == true
        && inspFields(['handlerConfirmedMet', 'handlerConfirmedMetAt',
                       'updatedAt']);
      
      // [Row 16] Propose a reschedule.
      // Site: inspection_service.dart:1358
      allow update: if (isTenant() || isHandler())
        && resource.data.status == 'approved'
        && (!('rescheduleProposal' in resource.data)
            || resource.data.rescheduleProposal == null)
        && (!('rescheduleCount' in resource.data)
            || resource.data.rescheduleCount < 2)
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 17] Counter-propose a reschedule.
      // Site: inspection_service.dart:1439
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 18] Approve a reschedule. Resets arrival/on-way flags
      // and bumps rescheduleCount.
      // Site: inspection_service.dart:1494
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && inspFields(['requestedDate', 'requestedTimeSlot',
                       'requestedTimeDisplay', 'rescheduleProposal',
                       'rescheduleCount',
                       'tenantArrived', 'tenantArrivedAt',
                       'handlerArrived', 'handlerArrivedAt',
                       'tenantOnWay', 'tenantOnWayAt',
                       'handlerOnWay', 'handlerOnWayAt',
                       'updatedAt']);
      
      // [Row 19] Decline a reschedule. Triggers refund via
      // _processRefund subroutine (row 9 clause).
      // Site: inspection_service.dart:1562
      // [Row 19] Decline a reschedule. Triggers refund via
      // _processRefund subroutine (row 9 clause).
      // Site: inspection_service.dart:1562
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && request.resource.data.status == 'declined'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'rescheduleProposal',
                       'updatedAt']);
      
      // [Row 20] Abandon a reschedule proposal. Any party with a
      // current proposal can clear it (including the proposer who
      // wants to back out).
      // Site: inspection_service.dart:1608
      allow update: if (isTenant() || isHandler())
        && 'rescheduleProposal' in resource.data
        && resource.data.rescheduleProposal != null
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 21] Handler cancels inspection on tenant's behalf.
      // Triggers refund via _processRefund (row 9 clause).
      // Site: inspection_service.dart:~1815
      allow update: if isHandler()
        && (resource.data.status == 'pending'
            || resource.data.status == 'approved')
        && request.resource.data.status == 'cancelled'
        && inspFields(['status', 'cancelledBy', 'cancellationReason',
                       'cancelledAt', 'rescheduleProposal',
                       'updatedAt']);
      
      // [Row 22] Tenant marks they're on the way.
      // Site: inspection_service.dart:1655
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && inspFields(['tenantOnWay', 'tenantOnWayAt', 'updatedAt']);
      
      // [Row 23] Handler marks they're on the way.
      // Site: inspection_service.dart:1702
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && inspFields(['handlerOnWay', 'handlerOnWayAt', 'updatedAt']);
      
      // [Row 24] Tenant passes on renting after a completed inspection.
      // Re-locks the exact address back to approximate.
      // Site: inspection_service.dart markTenantPassed
      allow update: if isTenant()
        && resource.data.status == 'completed'
        && request.resource.data.tenantPassed == true
        && inspFields(['tenantPassed', 'updatedAt']);
      
      // [Row 25] Tenant reschedules an inspection that expired unapproved —
      // re-enters the approval queue with a new date (payment is kept).
      // Site: inspection_service.dart rescheduleExpiredInspection
      allow update: if isTenant()
        && resource.data.status == 'expiredUnapproved'
        && request.resource.data.status == 'pending'
        && inspFields(['status', 'requestedDate', 'requestedTimeSlot',
            'updatedAt']);

      // [Row 26] Tenant takes the refund instead of rescheduling an
      // expired-unapproved inspection.
      // Site: inspection_service.dart refundExpiredInspection
      allow update: if isTenant()
        && resource.data.status == 'expiredUnapproved'
        && request.resource.data.status == 'refunded'
        && request.resource.data.paymentStatus == 'refunded'
        && inspFields(['status', 'paymentStatus', 'refundReason',
            'refundedAt', 'updatedAt']);

      // Admin override — any legitimate admin intervention.
      allow update: if isAdmin();
    }

    // Agent ratings collection
    match /agent_ratings/{ratingId} {
      allow read: if request.auth != null;
      // Create: the rater files under their OWN id (audit #3 — was
      // unconstrained, which let a client forge raterId / stuff ratings
      // attributed to other users). Matches agent_service.dart which sets
      // raterId to the current uid.
      allow create: if request.auth != null &&
        request.resource.data.raterId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.raterId == request.auth.uid;
      allow delete: if false;
    }
    
    // Rental interests collection
    match /rental_interests/{interestId} {
      // Create (H2 CLOSED): server-only. The figures on this document decide
      // what the tenant is charged for rent, and a client could previously set
      // them — minting an interest claiming ₦100 against a ₦1.2m tenancy, which
      // the rules then froze as immutable and initializePayment charged.
      // Creation now runs through the createRentalInterest callable, which
      // derives every amount from the property and config/pricing (Admin SDK
      // writes bypass this rule).
      allow create: if false;

      // canRead() first so an admin list/read short-circuits BEFORE the per-doc
      // get() lookups below (avoids their cost and a deny if a referenced
      // inspection is ever missing).
      allow read: if request.auth != null && (
        canRead() ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.tenantId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.landlordId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.agentId == request.auth.uid
      );

      // Update (M2): parties may drive the payment + acceptance lifecycle, but
      // the financial and identity fields are IMMUTABLE post-create — payouts,
      // amounts, fees, and the tenant/landlord/agent/property ids can't be
      // rewritten by a client. This is an ALLOWLIST of exactly the fields the
      // live update sites in rental_interest_service.dart touch (upload proof,
      // reject, mark verified, accept). Was: no field-allowlist (M2 hole).
      // Admin (below) updates freely.
      allow update: if request.auth != null
        && (resource.data.tenantId == request.auth.uid
            || resource.data.landlordId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'paymentReceiptUrl', 'paymentUploadedAt',
              'paymentRejectionReason', 'isPaymentVerified', 'paymentReference',
              'paymentVerifiedAt', 'paidAt', 'acceptedAt', 'updatedAt',
            ]);
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Active Rentals collection
    match /active_rentals/{rentalId} {
      // Create (H2): only the landlord, finalizing a tenant, and only from a
      // real rental_interest they own that has reached payment_verified/
      // accepted. A modified client can no longer fabricate an active rental
      // (and its landlord/agent payout rows) out of thin air — it must be
      // backed by a verified interest. Financial fields are still
      // client-denormalized from that interest; fully server-authoritative
      // figures require the Paystack-verification CF (tracked separately).
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.rentalInterestId is string
        && exists(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId))
        && get(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId)).data.landlordId == request.auth.uid
        && get(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId)).data.status in ['payment_verified', 'accepted'];

      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      // List/query: tenant or landlord on the rental, or admin. Hardened (H1):
      // was `if request.auth != null`, which let any authed user enumerate
      // every active rental. Tenant dashboards scope by tenantId; landlord
      // screens + the owner-only occupancy/management queries scope by
      // landlordId. The tenant-facing occupancy card now reads the property's
      // server-maintained currentTenantsCount instead of listing this.
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      // Admin can update freely (e.g. set pendingRentForRenewal after
      // approving a rent-review request).
      allow update: if isAdmin();

      // Tenant/landlord may update their own rental, but ONLY the fields the
      // client app legitimately writes (agreement workflow, payment reminder,
      // and the status / move-out / contest lifecycle). This is an ALLOWLIST,
      // not a blocklist: every financial and lease field — rentAmount,
      // pendingRentForRenewal, pendingRentEffectiveDate, agentFee, totalPaid,
      // all payout amounts/statuses, leaseStartDate/EndDate, nextPaymentDue —
      // is excluded, so a landlord (or tenant) cannot self-apply a rent change
      // or otherwise bypass the admin-approved rent-review / renewal flow. Those
      // fields are written only by Cloud Functions via the admin SDK, which
      // bypasses these rules. (The previous rule blocked just one field, which
      // left rentAmount and every payout field client-writable.)
      // NOTE: `status` is intentionally allowed (terminate / move-out /
      // expiry transitions are client-driven); value-level status-transition
      // locking is a separate state-machine hardening, not done here.
      allow update: if request.auth != null
        && (resource.data.tenantId == request.auth.uid
            || resource.data.landlordId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'agreementUrl', 'agreementUploadedAt', 'agreementStatus',
              'tenantDisputeReason', 'tenantAcceptedAt', 'landlordFinalizedAt',
              // Wet-signature trail. Acceptance used to write a status and a
              // timestamp and nothing else — leaving the only evidence of
              // agreement a row in our own database, which a tenant could
              // simply deny. These hold the actual signed documents: the
              // tenant's signed copy, then the counter-signed copy that
              // becomes the agreement of record.
              'tenantSignedUrl', 'tenantSignedAt',
              'executedAgreementUrl', 'executedAt',
              // Mid-tenancy revision, declared and then verified by the other
              // party. The landlord states a revision changes terms only and
              // not the rent; the tenant, who has to read the document to sign
              // it, can contradict that. `tenantFlaggedRentChange` is what an
              // onActiveRentalUpdated branch turns into an admin alert — a
              // false declaration becomes evidence rather than an argument.
              'agreementRevisedAt', 'agreementRevisionTermsOnly',
              'agreementRevisionDeclaredRent', 'tenantFlaggedRentChange',
              'hasPaymentReminder',
              'status', 'endReason', 'endedBy', 'endedAt',
              'tenantContested', 'tenantContestStatement', 'contestedAt',
              'moveOutRequestedAt', 'moveOutIntendedDate',
              // Caution-deposit declaration made by the landlord at handover.
              // A record only — ClearRent never custodies this money — but it
              // is what a dispute is judged on, so it is client-writable here
              // and read by the tenant.
              'cautionDeductionAmount', 'cautionDeductionReason',
              'cautionDeclaredAt',
              // ── Handover (move-out) ──────────────────────────────────────
              // The tenancy ends on the tenant's timeline; the PROPERTY stays
              // gated until this reaches 'closed'. Stage is advanced by both
              // parties in turn, which is why it is client-writable — the
              // server trigger reads it to decide when to release the unit.
              'handoverStage',
              // Tenant's condition evidence. Video takes precedence over
              // photos and both are captured live, never picked from a gallery
              // — a gallery pick could be a video of the place on move-IN day.
              // 'handoverEvidencePending' is the retry-later state: the
              // tenancy has already ended, but no caution claim can be made
              // until the upload actually lands.
              'handoverEvidenceAt', 'handoverEvidencePending',
              // The landlord attesting they physically checked the unit. This
              // is the relist lever — nothing frees the property without it.
              'handoverConditionConfirmedAt', 'handoverConditionNotes',
              // Settlement. `handoverSettlementMethod` is the seam for taking
              // the deposit through ClearRent later; today it only ever records
              // that the money moved landlord-to-tenant off-platform.
              'handoverSettlementMethod', 'handoverSettledAt',
              'handoverProofUrl', 'handoverProofUploadedAt',
              // Outgoing tenant's answer, and the silence fallback.
              'handoverTenantConfirmedAt',
              'updatedAt',
            ]);

      allow delete: if false;
    }
    // Rent-review requests — a landlord files to raise rent at renewal.
    // Eligibility (rental ownership + within 6 months of leaseEndDate) is
    // enforced in the mobile form and the CF; rules only ensure the filer
    // owns the request and can't self-approve. Admin decides; on approval
    // the admin CF writes pendingRentForRenewal onto the active_rental.
    match /rent_review_requests/{requestId} {
      // Landlord files for themselves; status must start as 'pending'.
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.status == 'pending';

      // The filing landlord, the tenant on the rental, or admin can read.
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        canRead()
      );

      // Queries filter by landlordId / tenantId (parties) or status (admin).
      // Hardened: was `if request.auth != null`, which let any authed user
      // enumerate every rent-review request.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        canRead()
      );

      // Only admin decides (approve/reject + decisionReason). The filing
      // landlord cannot edit after submitting.
      allow update: if request.auth != null && isAdmin();

      allow delete: if false;
    }
    
    // Issues collection - tenant reports, landlord reads
    match /issues/{issueId} {
      allow create: if request.auth != null;
      
      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      // List/query: parties only (tenant or landlord on the issue), or admin.
      // Hardened (H1): was `if request.auth != null`, which let any authed
      // user enumerate every issue. Every caller scopes by their own id —
      // tenant dashboards by tenantId, LandlordIssuesScreen + PropertyHealth
      // by landlordId (PropertyHealth client-filters propertyId).
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      allow update: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      allow delete: if false;
    }

    // Maintenance logs — landlord-only proactive maintenance records
    match /maintenance_logs/{logId} {
      // Only the landlord who owns the property can create logs
      allow create: if request.auth != null &&
        request.resource.data.landlordId == request.auth.uid;

      // Landlord reads their own logs; admin can read all
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      // List/query: the owning landlord only, or admin. Hardened (H1): was
      // `if request.auth != null`, which let any authed user enumerate every
      // maintenance log. PropertyHealthScreen now scopes by landlordId and
      // client-filters propertyId.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        canRead()
      );

      // Landlord can update or delete their own logs (e.g. correcting a note)
      allow update: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;
    }
    match /tenancy_links/{linkId} {
      allow create: if request.auth != null &&
        request.resource.data.landlordId == request.auth.uid;

      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        canRead()
      );

      // List queries must satisfy the same ownership constraint as get.
      // The only caller today (landlord_home_screen) filters by
      // landlordId == auth.uid, so this rule passes for that query.
      // Closes F1.13 — the previous "any authenticated user can list"
      // rule allowed any user to enumerate any landlord's or tenant's
      // tenancy history. Admin override preserved.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        canRead()
      );

      // Allowlist (parity with active_rentals): clients drive only the link
      // lifecycle — accept / reject / remove. Every term + financial field
      // (rentAmount, leaseStart/EndDate, rentDue*, rentFrequency) and the
      // admin-only pendingRent* / agreementUrl / promoted* fields are excluded,
      // so a landlord can't self-apply a rent change to a link and bypass the
      // admin-approved rent-review path. Those move only via Cloud Functions
      // (admin SDK, which bypasses these rules).
      // NOTE: `status` value transitions aren't locked here (a separate
      // state-machine hardening, as with active_rentals).
      allow update: if request.auth != null
        && (resource.data.landlordId == request.auth.uid
            || resource.data.tenantId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'acceptedAt', 'rejectedAt', 'removedAt',
            ]);

      allow delete: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;
    }
    // Announcements — readable by all authenticated users, managed by
    // admin only. Create additionally enforces createdBy == auth.uid so
    // the audit trail reflects which admin actually wrote the announcement
    // (matters once multiple admins exist; was a trusted client field
    // before Workstream 6).
    match /announcements/{announcementId} {
      allow read, list: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Transactions — parties involved can read, admin manages.
    // No client writes — transactions are written by Cloud Functions
    // only (admin SDK bypasses rules). Closes F1.11.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        canRead()
      );
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL transactions. Parties query their own row
      // (where landlordId|agentId|tenantId == uid); admin reads via the claim.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        canRead()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }
    // Notifications — writes only by Cloud Functions / admin.
    // Users can read their own and mark them as read, nothing else.
    match /notifications/{notificationId} {
      // Clients cannot create notifications. Cloud Functions and admin SDK
      // bypass these rules. Firebase Console writes also bypass.
      allow create: if false;

      // Recipients (and admin) can read their own.
      allow get: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        canRead()
      );

      // List/query: own notifications only (queries filter by userId).
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL notifications.
      allow list: if request.auth != null &&
        (resource.data.userId == request.auth.uid || canRead());

      // Recipients can mark as read (and only as read).
      //
      // `unreadCount` is part of marking read, not a separate power: chat
      // notifications are one rolling doc per conversation carrying a count of
      // the messages behind them, and opening the row has to clear that count
      // as well as the flag. It may only be zeroed — a recipient must not be
      // able to invent a count — and the three still travel as one write, so
      // this stays an allowlist rather than a general update.
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt', 'unreadCount']) &&
        request.resource.data.get('unreadCount', 0) == 0;

      // Admin can also update freely (e.g., to fix issues).
      allow update: if isAdmin();

      // Only admin can delete.
      allow delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL payment records. Clients query their own
      // (where userId == uid); admin reads collection-wide via the claim.
      allow list: if request.auth != null &&
        (resource.data.userId == request.auth.uid || canRead());

      // A user can create a payment record attributed to themselves
      // only (userId must match the writer).
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Owner can update their own payment record (status transitions
      // written client-side during checkout/refund).
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if false;
    }
    // Refunds — written by Cloud Functions, read by beneficiaries + admin,
    // marked paid by markRefundPaid Cloud Function only.
    match /refunds/{refundId} {
      // Created by onInspectionRefundTriggered (admin SDK bypasses).
      allow create: if false;

      // Beneficiary reads their own; admin reads all.
      allow get: if request.auth != null && (
        resource.data.beneficiaryId == request.auth.uid ||
        canRead()
      );

      // List/query: own refunds only (tenant uses a doc-get; only admin
      // lists collection-wide on the Refunds queue). Hardened: was
      // `if request.auth != null`, which exposed ALL refund records.
      allow list: if request.auth != null &&
        (resource.data.beneficiaryId == request.auth.uid || canRead());

      // Updates only via markRefundPaid CF (admin SDK bypasses).
      allow update: if false;

      // No deletes.
      allow delete: if false;
    }

    // Admin request queue. The app files items here best-effort — currently
    // only 'unknown_area' reports, created when a landlord drops a property pin
    // in an area not yet in our list (see add_property / ClearRentLocationPicker).
    // The admin dashboard lists them and marks each added/dismissed.
    //   - create: any signed-in user, but shape-constrained to a pending
    //     'unknown_area' report so a client can't forge arbitrary admin state.
    //   - read: admins + read-only viewers (canRead).
    //   - update/delete: admins only.
    match /admin_requests/{requestId} {
      allow read: if canRead();
      allow create: if request.auth != null
        && request.resource.data.type == 'unknown_area'
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Admin audit log — append-only, written by admin money-ops CFs.
    // Never updated, never deleted. Read by admin only.
    match /admin_audit_log/{entryId} {
      allow create: if false;     // Admin SDK only
      allow read: if isAdmin();
      allow update: if false;     // Immutable
      allow delete: if false;     // Immutable
    }

    // Admin alerts — the web dashboard's ping/queue feed. Written only by the
    // admin SDK (writeAdminAlert in Cloud Functions). Full admins and read-only
    // viewers can read; only full admins may mark read / resolve or delete.
    match /admin_alerts/{alertId} {
      allow create: if false;             // Admin SDK only
      allow read, list: if canRead();
      allow update: if isAdmin();         // mark read / resolve
      allow delete: if isAdmin();
    }

    // Admin push devices — the FCM tokens the dashboard registers so an
    // actionable alert can reach an admin who does NOT have the dashboard open.
    //
    // A registry exists because admin identity is a custom claim, which
    // Firestore cannot query: there is no "select all admins". The alternative
    // was paginating listUsers() on every alert. See admin_push_ops.ts.
    //
    // Doc id IS the admin's uid, and an admin may only touch their own — so a
    // compromised admin session cannot silence a colleague by clearing their
    // tokens, nor point another admin's push at itself. Only the fan-out
    // function (admin SDK) reads across the collection.
    match /admin_devices/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow list: if false;               // Admin SDK only; no enumeration

      // Create and update are separate clauses because `resource` is null on
      // create — calling diff() against it there would error, not just deny.
      allow create: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys()
             .hasOnly(['tokens', 'updatedAt', 'userAgent']);
      allow update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tokens', 'updatedAt', 'userAgent']);

      allow delete: if isAdmin() && request.auth.uid == uid;
    }

    // Deleted-account tombstones — written by deleteMyAccount (admin SDK) as
    // the account goes. Financial records outlive the account for audit and
    // still reference its uid; this is how the dashboard tells "deleted
    // account" apart from a live party instead of rendering a ghost row.
    // Read-only to admins and viewers; nothing may write or remove one from a
    // client, or the audit trail could be erased.
    match /deleted_accounts/{uid} {
      allow create: if false;             // Admin SDK only
      allow read, list: if canRead();
      allow update: if false;             // Immutable
      allow delete: if false;             // Immutable
    }
  }
}