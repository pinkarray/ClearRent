rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin identity check. Passes if the caller's ID token carries
    // either the admin or superAdmin custom claim. Claims are set via
    // the setAdminClaim Cloud Function (which itself requires superAdmin
    // to invoke). The bootstrap superAdmin is set out-of-band via the
    // local scripts/bootstrap-superadmin.ts script.
    function isAdmin() {
      return (request.auth.token.admin == true)
        || (request.auth.token.superAdmin == true);
    }

    // Super admin identity check. Used by surfaces that should be
    // gated specifically to super admins (e.g. managing other admins).
    // Currently no rules reference this — it's available for Workstream
    // 6 follow-ups and any rule that needs a stricter gate than isAdmin.
    function isSuperAdmin() {
      return (request.auth.token.superAdmin == true);
    }
    
    // Internal — locked. Only Cloud Functions (admin SDK) write here.
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // Phone-to-email lookup at sign-in goes through the
      // lookupEmailByPhone Cloud Function, which uses admin SDK
      // (bypasses rules). Clients must be authenticated to list users.
      allow list: if request.auth != null;
      
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      
      // Allow updating allowsCalls field specifically
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowsCalls', 'updatedAt']);

      // Allow user to persist dismissed announcement IDs to their own doc
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAnnouncements']);

      // Any authenticated user can update rating fields only (tenant rates agent/landlord)
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'totalRatings']);

      // Earnings fields (pendingEarnings, paidEarnings) are written
      // exclusively by Cloud Functions using admin SDK — the W1
      // creditInspectionEarnings CF credits, the W5 markInspection
      // AgentPayoutPaid CF shifts pending→paid. Admin SDK bypasses
      // these rules, so no allow-update clause is needed for them.

      // Saved properties subcollection
      match /savedProperties/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Private subcollection (C1) — sensitive data that must NOT live on the
      // user doc (which is readable by any authenticated user). Holds
      // `private/bank` (account number/name/bank). Readable only by the owner
      // and admin (payout pages); writable only by the owner. Cloud Functions
      // use the admin SDK and bypass these rules.
      match /private/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || isAdmin()
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Verification requests collection. Highly sensitive — contains NIN
    // URLs, utility bills, and payment references. Closes F1.9 (previously
    // any authenticated user could read every verification request).
    match /verification_requests/{requestId} {
      // Create: any authenticated user can submit their own verification
      // request, and the userId on the doc must be themselves (closes a
      // would-be vector where a fraudster submits a verification request
      // pointing at someone else's docs).
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Get/read: only the submitter or admin.
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // List/query: same ownership constraint. The only caller today is
      // verification_service line ~433, which queries the submitter's
      // own requests. Admin webapp doesn't query this collection
      // (verification status is mirrored on the users doc instead).
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Update: admin only (status transitions: pending → verified/rejected).
      allow update: if isAdmin();

      // No deletes from clients.
      allow delete: if false;
    }
    
    // Properties collection
    match /properties/{propertyId} {
      allow read: if request.auth != null;

      // A unit may only reference a building the SAME landlord owns — otherwise
      // a modified client could borrow another owner's verified C of O by
      // setting their buildingId. True when no building is referenced.
      function buildingOwnedByCaller() {
        return !('buildingId' in request.resource.data)
          || request.resource.data.buildingId == null
          || (
            exists(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId))
            && get(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId)).data.landlordId == request.auth.uid
          );
      }

      // Create: must self-assign ownership AND be a verified landlord.
      // The get() reads the user doc (source of truth) rather than the
      // client-supplied isVerified field, which a modified client could fake.
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified'
        && buildingOwnedByCaller();

      // Update: owner can edit own listing, but cannot reassign
      // ownership (closes listing-hijack via landlordId rewrite) and cannot
      // attach a building they don't own.
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.landlordId == resource.data.landlordId
        && buildingOwnedByCaller()
        // Owner may move the doc back to review ('pending'/'not_uploaded' on
        // re-upload) but may NOT self-verify or self-reject — those are
        // admin-only (the admin clause below bypasses this). Mirrors buildings.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownershipDocStatus'])
          || !(request.resource.data.ownershipDocStatus in ['verified', 'rejected'])
        )
        && (
          (resource.data.get('currentTenantsCount', 0) <= 0)
          || (
            request.resource.data.rent == resource.data.rent
            && request.resource.data.agentFee == resource.data.agentFee
            && request.resource.data.cautionDeposit == resource.data.cautionDeposit
          )
        );

      // Admin override for verification/availability updates from
      // the Next.js admin dashboard.
      allow update: if isAdmin();

      // Any authenticated user can update the engagement counters
      // (inquiryCount, viewCount, savedCount) on a property they
      // don't own. These are bumped by non-owners during normal use:
      // viewCount on open, savedCount on save/unsave, inquiryCount on
      // inspection request. Field-scoped — only these three keys may
      // change through this clause, so ownership-sensitive fields
      // (rent, landlordId, isAvailable, etc.) remain protected.
      // Values are not delta-checked: these are cosmetic metrics and
      // delta enforcement added fragility without protecting anything
      // of value. (Reviewed and chosen deliberately, not an oversight.)
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['inquiryCount', 'viewCount', 'savedCount']);

      // Delete: owner or admin
      allow delete: if request.auth != null
        && resource.data.landlordId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Buildings — group multiple unit listings of one landlord so a single
    // ownership document (C of O / deed) is verified ONCE and covers every
    // unit. Units reference buildingId and inherit the building's
    // ownershipDocStatus. A standalone listing has no building.
    match /buildings/{buildingId} {
      // Landlord creates their own building; the doc must start unverified
      // (can't self-assign 'verified'/'rejected').
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && (request.resource.data.ownershipDocStatus == 'none'
            || request.resource.data.ownershipDocStatus == 'pending');

      // Readable by any authenticated user — a prospective tenant viewing a
      // unit needs the building's doc status for the inspection gate (mirrors
      // properties being readable; the C of O URL is no more sensitive than the
      // per-property ownershipDocUrl already is).
      allow get: if request.auth != null;

      // List: the owner (add-property "join a building" picker) or admin (the
      // grouped approval queue). Ownership-constrained to satisfy query safety.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid || isAdmin()
      );

      // Admin verifies / rejects the shared ownership doc.
      allow update: if isAdmin();

      // Owner may edit building details and (re)upload the doc, but may NOT
      // self-verify: ownershipDocStatus may only be set to 'pending' (resubmit
      // after rejection), never 'verified'/'rejected', and the rejection reason
      // is admin-only. landlordId is immutable.
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.landlordId == resource.data.landlordId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'address', 'ownershipDocUrl', 'ownershipDocType',
              'ownershipDocStatus', 'updatedAt',
            ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownershipDocStatus'])
          || request.resource.data.ownershipDocStatus == 'pending'
        );

      // No client deletes — a building may have units; admin SDK handles cleanup.
      allow delete: if isAdmin();
    }

    // Conversations collection - FIXED query permissions
    match /conversations/{conversationId} {
      
      // Helper: user is an active participant (not removed)
      function isActiveParticipant() {
        return request.auth.uid in resource.data.participants
          && (
            !('removedParticipants' in resource.data) 
            || !(request.auth.uid in resource.data.removedParticipants)
          );
      }
      
      // Get single doc: only active participants and admin
      allow get: if request.auth != null && (
        isActiveParticipant() || isAdmin()
      );
      
      // List/query (M3): the caller must be a party to every matched doc —
      // a participant, or the landlord/tenant/agent named on it, or admin.
      // Hardened: was `if request.auth != null`, which let any authed user
      // enumerate every conversation. Live queries scope by
      // `participants array-contains uid` (inbox + the agent-path dedup) or by
      // landlordId/tenantId/agentId == uid (the party-initiated dedup checks).
      allow list: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
      
      // Create: user must be in the participants list they're creating
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Update: active participants and admin
      allow update: if request.auth != null && (
        isActiveParticipant() || isAdmin()
      );
      
      // Delete: admin only
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.participants
            && resource.data.lastMessage == '');
      
      // Messages subcollection
      match /messages/{messageId} {
        // Helper: check parent conversation for active participation
        function isConversationParticipant() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return request.auth.uid in conv.participants
            && (
              !('removedParticipants' in conv) 
              || !(request.auth.uid in conv.removedParticipants)
            );
        }
        
        // Read: active participants and admin
        allow read: if request.auth != null && (
          isConversationParticipant() || isAdmin()
        );
        
        // Create: active participant, and either they are the sender OR it's a system message they're inserting
        allow create: if request.auth != null && 
          isConversationParticipant() && (
            request.resource.data.senderId == request.auth.uid ||
            request.resource.data.senderId == 'system'
          );
        
        // Update (mark as read): active participants and admin
        allow update: if request.auth != null && (
          isConversationParticipant() || isAdmin()
        );
        
        // No delete
        allow delete: if false;
      }
    }
    
    // Activities collection
    match /activities/{activityId} {
      // Read/list (M1): the landlord whose feed it is, the actor who generated
      // it, or admin. Hardened — was `if request.auth != null`, which let any
      // authed user enumerate the entire activity feed (who viewed/inquired on
      // which property, landlord ids, payment events). Live queries scope by
      // landlordId == uid (the landlord's feed) or actorId == uid (the
      // view/inquiry dedup checks). landlordId is checked first so the feed
      // query short-circuits before touching actorId (absent on some docs).
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.actorId == request.auth.uid ||
        isAdmin()
      );

      // Create: any authed user logs an activity. The actor/landlord shapes
      // vary across call sites (some omit actorId), and the sensitive exposure
      // was the read above — so create stays auth-gated, not field-constrained.
      allow create: if request.auth != null;

      // Update (M1): only the feed owner, and only to mark an item read
      // (markAsRead — the sole update site, activity_service.dart).
      allow update: if request.auth != null
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead']);
    }
    
    // Saved properties (top-level) — DEAD COLLECTION.
    // The mobile app uses the per-user /users/{userId}/savedProperties
    // subcollection. No code reads or writes this top-level collection
    // (verified via grep across Flutter app, Next.js webapp, and CFs).
    // Locked down to prevent any future accidental writes from being
    // readable by other users. Closes F1.10.
    match /saved_properties/{docId} {
      allow read, write: if false;
    }
    
    // Inspection requests collection.
    //
    // Update rules form a state-machine field lockdown (closes F1.6
    // and F1.12). Each allow-update clause maps to exactly one update
    // site in mobile/inspection_service.dart. Clauses enforce:
    //   - WHO (role check via helper functions)
    //   - WHAT (hasOnly() limits which fields can be touched)
    //   - WHEN (status preconditions, where the operation only makes
    //     sense at a specific point in the lifecycle)
    //
    // Time-based preconditions (reschedule window, on-the-way cutoff
    // 2hrs before scheduled time) are intentionally NOT enforced in
    // rules — product logic, not security.
    match /inspection_requests/{requestId} {
      
      // ─── Helpers ─────────────────────────────────────────────
      
      // Handler = whoever is conducting the inspection. Agent if
      // assigned, else landlord (self-handled).
      function isHandler() {
        return (resource.data.agentId != null
                && resource.data.agentId == request.auth.uid)
          || (resource.data.agentId == null
                && resource.data.landlordId == request.auth.uid);
      }
      
      function isTenant() {
        return resource.data.tenantId == request.auth.uid;
      }
      
      function isLandlord() {
        return resource.data.landlordId == request.auth.uid;
      }
      
      function isAgent() {
        return resource.data.agentId != null
          && resource.data.agentId == request.auth.uid;
      }
      
      // Convenience wrapper for the hasOnly() check.
      function inspFields(fields) {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(fields);
      }
      
      // Receiver of the current reschedule proposal — i.e. the
      // opposite side from whoever proposed it. Used by row 17, 18,
      // 19 (counter, approve, decline of an existing proposal).
      function isRescheduleReceiver() {
        return 'rescheduleProposal' in resource.data
          && resource.data.rescheduleProposal != null
          && resource.data.rescheduleProposal.proposedByUserId
             != request.auth.uid
          && (isTenant() || isAgent() || isLandlord());
      }
      
      // ─── Create / read / list / delete (unchanged) ───────────
      
      allow create: if request.auth != null;
      
      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      // List/query: a party to the inspection (tenant/landlord/agent), or
      // admin. Hardened (H1): was `if request.auth != null`, which let any
      // authed user enumerate every inspection request. Every live client
      // query scopes by tenantId/landlordId/agentId == uid.
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if false;
      
      // ─── State-machine updates (closes F1.6 + F1.12) ─────────
      
      // [Row 14a] Handler approves request (normal).
      // Site: inspection_service.dart:627
      allow update: if isHandler()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification')
        && request.resource.data.status == 'approved'
        && inspFields(['status', 'updatedAt']);
      
      // [Row 14b] Landlord overrides agent decline by approving.
      // Site: inspection_service.dart:627 (override branch)
      allow update: if isLandlord()
        && resource.data.status == 'declinedByAgent'
        && request.resource.data.status == 'approved'
        && inspFields(['status', 'updatedAt',
                       'wasOverridden', 'overriddenBy']);
      
      // [Row 1] Agent declines request.
      // Site: inspection_service.dart:751
      allow update: if isAgent()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification')
        && request.resource.data.status == 'declinedByAgent'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'landlordOverrideDeadline',
                       'originalDeclineBy', 'updatedAt']);
      
      // [Row 2] finalDeclineRequest — auto-decline after 12hr
      // deadline. No mobile clause. Will be CF-only when implemented
      // (see parking lot). Admin SDK bypasses these rules.
      
      // [Row 3] Landlord declines (initial or override).
      // Site: inspection_service.dart:854
      allow update: if isLandlord()
        && (resource.data.status == 'pending'
            || resource.data.status == 'pendingVerification'
            || resource.data.status == 'approved')
        && request.resource.data.status == 'declined'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'wasOverridden', 'overriddenBy',
                       'updatedAt']);
      
      // [Row 4] Tenant marks themselves arrived.
      // Site: inspection_service.dart:907
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && inspFields(['tenantArrived', 'tenantArrivedAt', 'updatedAt']);
      
      // [Row 5] Handler marks themselves arrived.
      // Site: inspection_service.dart:961
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && inspFields(['handlerArrived', 'handlerArrivedAt', 'updatedAt']);
      
      // [Row 6] Handler marks inspection complete. Triggers W1
      // creditInspectionEarnings CF.
      // Site: inspection_service.dart:1035
      // Defensive: 'met' may be absent on legacy/test docs; use
      // `in` check pattern.
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && 'met' in resource.data
        && resource.data.met == true
        && request.resource.data.status == 'completed'
        && inspFields(['status', 'completedAt', 'agentPayoutStatus',
                       'completedBy', 'completedByType', 'updatedAt']);
      
      // [Row 7] Tenant rates the inspection post-completion.
      // Site: inspection_service.dart:1129
      // Note: tenantRated field may be absent on never-rated docs.
      // Use `in` check to avoid evaluation error on missing field.
      allow update: if isTenant()
        && resource.data.status == 'completed'
        && (!('tenantRated' in resource.data)
            || resource.data.tenantRated != true)
        && inspFields(['tenantRating', 'tenantReview', 'tenantRated',
                       'ratingSubmittedAt', 'ratedUserId',
                       'ratedUserType', 'ratedUserName', 'updatedAt']);

      // [Row 8] Tenant cancels their unpaid inspection request.
      // Site: inspection_service.dart:1271
      allow update: if isTenant()
        && resource.data.status == 'pendingPayment'
        && request.resource.data.status == 'cancelled'
        && inspFields(['status', 'updatedAt']);
      
      // [Row 9] _processRefund — subroutine called after a paid
      // inspection is declined or cancelled. Inherits caller's auth.
      // Site: inspection_service.dart:2103
      allow update: if (isLandlord() || isTenant() || isHandler())
        && resource.data.paymentStatus == 'paid'
        && request.resource.data.paymentStatus == 'refunded'
        && inspFields(['paymentStatus', 'refundedAt', 'refundReason']);
      
      // [Row 10] Admin verifies payment.
      // Site: inspection_service.dart:2164
      allow update: if isAdmin()
        && resource.data.status == 'pendingPayment'
        && inspFields(['paymentStatus', 'paymentVerifiedAt',
                       'paymentVerifiedBy', 'paidAt', 'status',
                       'updatedAt']);
      
      // [Row 11] Admin rejects payment.
      // Site: inspection_service.dart:2232
      allow update: if isAdmin()
        && resource.data.status == 'pendingPayment'
        && inspFields(['paymentStatus', 'status', 'declineReason',
                       'updatedAt']);
            
      // [Row 13] Handler confirms they received payment.
      // Site: inspection_service.dart:2408
      allow update: if isHandler()
        && resource.data.agentPayoutStatus == 'paid'
        && inspFields(['agentConfirmedPayment', 'agentConfirmedAt',
                       'updatedAt']);
      
      // [Row 15a] Tenant marks they met.
      // Site: inspection_service.dart:~1758
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && resource.data.tenantArrived == true
        && request.resource.data.met == true
        && request.resource.data.metBy == 'tenant'
        && inspFields(['met', 'metAt', 'metBy', 'updatedAt']);
      
      // [Row 15b] Handler marks they met.
      // Site: inspection_service.dart:~1758
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && resource.data.tenantArrived == true
        && resource.data.handlerArrived == true
        && request.resource.data.met == true
        && request.resource.data.metBy == 'handler'
        && inspFields(['met', 'metAt', 'metBy', 'updatedAt']);
      
      // [Row 16] Propose a reschedule.
      // Site: inspection_service.dart:1358
      allow update: if (isTenant() || isHandler())
        && resource.data.status == 'approved'
        && (!('rescheduleProposal' in resource.data)
            || resource.data.rescheduleProposal == null)
        && (!('rescheduleCount' in resource.data)
            || resource.data.rescheduleCount < 2)
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 17] Counter-propose a reschedule.
      // Site: inspection_service.dart:1439
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 18] Approve a reschedule. Resets arrival/on-way flags
      // and bumps rescheduleCount.
      // Site: inspection_service.dart:1494
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && inspFields(['requestedDate', 'requestedTimeSlot',
                       'requestedTimeDisplay', 'rescheduleProposal',
                       'rescheduleCount',
                       'tenantArrived', 'tenantArrivedAt',
                       'handlerArrived', 'handlerArrivedAt',
                       'tenantOnWay', 'tenantOnWayAt',
                       'handlerOnWay', 'handlerOnWayAt',
                       'updatedAt']);
      
      // [Row 19] Decline a reschedule. Triggers refund via
      // _processRefund subroutine (row 9 clause).
      // Site: inspection_service.dart:1562
      // [Row 19] Decline a reschedule. Triggers refund via
      // _processRefund subroutine (row 9 clause).
      // Site: inspection_service.dart:1562
      allow update: if isRescheduleReceiver()
        && resource.data.status == 'approved'
        && request.resource.data.status == 'declined'
        && inspFields(['status', 'declinedBy', 'declineReason',
                       'declinedAt', 'rescheduleProposal',
                       'updatedAt']);
      
      // [Row 20] Abandon a reschedule proposal. Any party with a
      // current proposal can clear it (including the proposer who
      // wants to back out).
      // Site: inspection_service.dart:1608
      allow update: if (isTenant() || isHandler())
        && 'rescheduleProposal' in resource.data
        && resource.data.rescheduleProposal != null
        && inspFields(['rescheduleProposal', 'updatedAt']);
      
      // [Row 21] Handler cancels inspection on tenant's behalf.
      // Triggers refund via _processRefund (row 9 clause).
      // Site: inspection_service.dart:~1815
      allow update: if isHandler()
        && (resource.data.status == 'pending'
            || resource.data.status == 'approved')
        && request.resource.data.status == 'cancelled'
        && inspFields(['status', 'cancelledBy', 'cancellationReason',
                       'cancelledAt', 'rescheduleProposal',
                       'updatedAt']);
      
      // [Row 22] Tenant marks they're on the way.
      // Site: inspection_service.dart:1655
      allow update: if isTenant()
        && resource.data.status == 'approved'
        && inspFields(['tenantOnWay', 'tenantOnWayAt', 'updatedAt']);
      
      // [Row 23] Handler marks they're on the way.
      // Site: inspection_service.dart:1702
      allow update: if isHandler()
        && resource.data.status == 'approved'
        && inspFields(['handlerOnWay', 'handlerOnWayAt', 'updatedAt']);
      
      // [Row 24] Tenant passes on renting after a completed inspection.
      // Re-locks the exact address back to approximate.
      // Site: inspection_service.dart markTenantPassed
      allow update: if isTenant()
        && resource.data.status == 'completed'
        && request.resource.data.tenantPassed == true
        && inspFields(['tenantPassed', 'updatedAt']);
      
      // [Row 25] Tenant reschedules an inspection that expired unapproved —
      // re-enters the approval queue with a new date (payment is kept).
      // Site: inspection_service.dart rescheduleExpiredInspection
      allow update: if isTenant()
        && resource.data.status == 'expiredUnapproved'
        && request.resource.data.status == 'pending'
        && inspFields(['status', 'requestedDate', 'requestedTimeSlot',
            'updatedAt']);

      // [Row 26] Tenant takes the refund instead of rescheduling an
      // expired-unapproved inspection.
      // Site: inspection_service.dart refundExpiredInspection
      allow update: if isTenant()
        && resource.data.status == 'expiredUnapproved'
        && request.resource.data.status == 'refunded'
        && request.resource.data.paymentStatus == 'refunded'
        && inspFields(['status', 'paymentStatus', 'refundReason',
            'refundedAt', 'updatedAt']);

      // Admin override — any legitimate admin intervention.
      allow update: if isAdmin();
    }

    // Agent ratings collection
    match /agent_ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        resource.data.raterId == request.auth.uid;
      allow delete: if false;
    }
    
    // Rental interests collection
    match /rental_interests/{interestId} {
      // Create (H2): the tenant files their own interest, and it must START
      // unpaid. A modified client can no longer mint an already
      // 'payment_verified'/'accepted' interest out of thin air — the payment
      // and acceptance state machine is driven by later updates (and admin).
      // NOTE: payout figures are still client-denormalized here; making them
      // server-authoritative requires the Paystack-verification CF (tracked
      // separately, see HANDOVER H2).
      allow create: if request.auth != null
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == 'pending_payment';

      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.tenantId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.landlordId == request.auth.uid ||
        get(/databases/$(database)/documents/inspection_requests/$(resource.data.inspectionRequestId)).data.agentId == request.auth.uid ||
        isAdmin()
      );

      // Update (M2): parties may drive the payment + acceptance lifecycle, but
      // the financial and identity fields are IMMUTABLE post-create — payouts,
      // amounts, fees, and the tenant/landlord/agent/property ids can't be
      // rewritten by a client. This is an ALLOWLIST of exactly the fields the
      // live update sites in rental_interest_service.dart touch (upload proof,
      // reject, mark verified, accept). Was: no field-allowlist (M2 hole).
      // Admin (below) updates freely.
      allow update: if request.auth != null
        && (resource.data.tenantId == request.auth.uid
            || resource.data.landlordId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'paymentReceiptUrl', 'paymentUploadedAt',
              'paymentRejectionReason', 'isPaymentVerified', 'paymentReference',
              'paymentVerifiedAt', 'paidAt', 'acceptedAt', 'updatedAt',
            ]);
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Active Rentals collection
    match /active_rentals/{rentalId} {
      // Create (H2): only the landlord, finalizing a tenant, and only from a
      // real rental_interest they own that has reached payment_verified/
      // accepted. A modified client can no longer fabricate an active rental
      // (and its landlord/agent payout rows) out of thin air — it must be
      // backed by a verified interest. Financial fields are still
      // client-denormalized from that interest; fully server-authoritative
      // figures require the Paystack-verification CF (tracked separately).
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.rentalInterestId is string
        && exists(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId))
        && get(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId)).data.landlordId == request.auth.uid
        && get(/databases/$(database)/documents/rental_interests/$(request.resource.data.rentalInterestId)).data.status in ['payment_verified', 'accepted'];

      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      // List/query: tenant or landlord on the rental, or admin. Hardened (H1):
      // was `if request.auth != null`, which let any authed user enumerate
      // every active rental. Tenant dashboards scope by tenantId; landlord
      // screens + the owner-only occupancy/management queries scope by
      // landlordId. The tenant-facing occupancy card now reads the property's
      // server-maintained currentTenantsCount instead of listing this.
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      // Admin can update freely (e.g. set pendingRentForRenewal after
      // approving a rent-review request).
      allow update: if isAdmin();

      // Tenant/landlord may update their own rental, but ONLY the fields the
      // client app legitimately writes (agreement workflow, payment reminder,
      // and the status / move-out / contest lifecycle). This is an ALLOWLIST,
      // not a blocklist: every financial and lease field — rentAmount,
      // pendingRentForRenewal, pendingRentEffectiveDate, agentFee, totalPaid,
      // all payout amounts/statuses, leaseStartDate/EndDate, nextPaymentDue —
      // is excluded, so a landlord (or tenant) cannot self-apply a rent change
      // or otherwise bypass the admin-approved rent-review / renewal flow. Those
      // fields are written only by Cloud Functions via the admin SDK, which
      // bypasses these rules. (The previous rule blocked just one field, which
      // left rentAmount and every payout field client-writable.)
      // NOTE: `status` is intentionally allowed (terminate / move-out /
      // expiry transitions are client-driven); value-level status-transition
      // locking is a separate state-machine hardening, not done here.
      allow update: if request.auth != null
        && (resource.data.tenantId == request.auth.uid
            || resource.data.landlordId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'agreementUrl', 'agreementUploadedAt', 'agreementStatus',
              'tenantDisputeReason', 'tenantAcceptedAt', 'landlordFinalizedAt',
              'hasPaymentReminder',
              'status', 'endReason', 'endedBy', 'endedAt',
              'tenantContested', 'tenantContestStatement', 'contestedAt',
              'updatedAt',
            ]);

      allow delete: if false;
    }
    // Rent-review requests — a landlord files to raise rent at renewal.
    // Eligibility (rental ownership + within 6 months of leaseEndDate) is
    // enforced in the mobile form and the CF; rules only ensure the filer
    // owns the request and can't self-approve. Admin decides; on approval
    // the admin CF writes pendingRentForRenewal onto the active_rental.
    match /rent_review_requests/{requestId} {
      // Landlord files for themselves; status must start as 'pending'.
      allow create: if request.auth != null
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.status == 'pending';

      // The filing landlord, the tenant on the rental, or admin can read.
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        isAdmin()
      );

      // Queries filter by landlordId / tenantId (parties) or status (admin).
      // Hardened: was `if request.auth != null`, which let any authed user
      // enumerate every rent-review request.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        isAdmin()
      );

      // Only admin decides (approve/reject + decisionReason). The filing
      // landlord cannot edit after submitting.
      allow update: if request.auth != null && isAdmin();

      allow delete: if false;
    }
    
    // Issues collection - tenant reports, landlord reads
    match /issues/{issueId} {
      allow create: if request.auth != null;
      
      allow read: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      // List/query: parties only (tenant or landlord on the issue), or admin.
      // Hardened (H1): was `if request.auth != null`, which let any authed
      // user enumerate every issue. Every caller scopes by their own id —
      // tenant dashboards by tenantId, LandlordIssuesScreen + PropertyHealth
      // by landlordId (PropertyHealth client-filters propertyId).
      allow list: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      allow update: if request.auth != null && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if false;
    }

    // Maintenance logs — landlord-only proactive maintenance records
    match /maintenance_logs/{logId} {
      // Only the landlord who owns the property can create logs
      allow create: if request.auth != null &&
        request.resource.data.landlordId == request.auth.uid;

      // Landlord reads their own logs; admin can read all
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      // List/query: the owning landlord only, or admin. Hardened (H1): was
      // `if request.auth != null`, which let any authed user enumerate every
      // maintenance log. PropertyHealthScreen now scopes by landlordId and
      // client-filters propertyId.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );

      // Landlord can update or delete their own logs (e.g. correcting a note)
      allow update: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;
    }
    match /tenancy_links/{linkId} {
      allow create: if request.auth != null &&
        request.resource.data.landlordId == request.auth.uid;

      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        isAdmin()
      );

      // List queries must satisfy the same ownership constraint as get.
      // The only caller today (landlord_home_screen) filters by
      // landlordId == auth.uid, so this rule passes for that query.
      // Closes F1.13 — the previous "any authenticated user can list"
      // rule allowed any user to enumerate any landlord's or tenant's
      // tenancy history. Admin override preserved.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        isAdmin()
      );

      // Allowlist (parity with active_rentals): clients drive only the link
      // lifecycle — accept / reject / remove. Every term + financial field
      // (rentAmount, leaseStart/EndDate, rentDue*, rentFrequency) and the
      // admin-only pendingRent* / agreementUrl / promoted* fields are excluded,
      // so a landlord can't self-apply a rent change to a link and bypass the
      // admin-approved rent-review path. Those move only via Cloud Functions
      // (admin SDK, which bypasses these rules).
      // NOTE: `status` value transitions aren't locked here (a separate
      // state-machine hardening, as with active_rentals).
      allow update: if request.auth != null
        && (resource.data.landlordId == request.auth.uid
            || resource.data.tenantId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'acceptedAt', 'rejectedAt', 'removedAt',
            ]);

      allow delete: if request.auth != null &&
        resource.data.landlordId == request.auth.uid;
    }
    // Announcements — readable by all authenticated users, managed by
    // admin only. Create additionally enforces createdBy == auth.uid so
    // the audit trail reflects which admin actually wrote the announcement
    // (matters once multiple admins exist; was a trusted client field
    // before Workstream 6).
    match /announcements/{announcementId} {
      allow read, list: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Transactions — parties involved can read, admin manages.
    // No client writes — transactions are written by Cloud Functions
    // only (admin SDK bypasses rules). Closes F1.11.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL transactions. Parties query their own row
      // (where landlordId|agentId|tenantId == uid); admin reads via the claim.
      allow list: if request.auth != null && (
        resource.data.landlordId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }
    // Notifications — writes only by Cloud Functions / admin.
    // Users can read their own and mark them as read, nothing else.
    match /notifications/{notificationId} {
      // Clients cannot create notifications. Cloud Functions and admin SDK
      // bypass these rules. Firebase Console writes also bypass.
      allow create: if false;

      // Recipients (and admin) can read their own.
      allow get: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // List/query: own notifications only (queries filter by userId).
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL notifications.
      allow list: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Recipients can mark as read (and only as read).
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt']);

      // Admin can also update freely (e.g., to fix issues).
      allow update: if isAdmin();

      // Only admin can delete.
      allow delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Hardened: was `if request.auth != null`, which let any authenticated
      // user query ALL payment records. Clients query their own
      // (where userId == uid); admin reads collection-wide via the claim.
      allow list: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // A user can create a payment record attributed to themselves
      // only (userId must match the writer).
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Owner can update their own payment record (status transitions
      // written client-side during checkout/refund).
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if false;
    }
    // Refunds — written by Cloud Functions, read by beneficiaries + admin,
    // marked paid by markRefundPaid Cloud Function only.
    match /refunds/{refundId} {
      // Created by onInspectionRefundTriggered (admin SDK bypasses).
      allow create: if false;

      // Beneficiary reads their own; admin reads all.
      allow get: if request.auth != null && (
        resource.data.beneficiaryId == request.auth.uid ||
        isAdmin()
      );

      // List/query: own refunds only (tenant uses a doc-get; only admin
      // lists collection-wide on the Refunds queue). Hardened: was
      // `if request.auth != null`, which exposed ALL refund records.
      allow list: if request.auth != null &&
        (resource.data.beneficiaryId == request.auth.uid || isAdmin());

      // Updates only via markRefundPaid CF (admin SDK bypasses).
      allow update: if false;

      // No deletes.
      allow delete: if false;
    }

    // Admin audit log — append-only, written by admin money-ops CFs.
    // Never updated, never deleted. Read by admin only.
    match /admin_audit_log/{entryId} {
      allow create: if false;     // Admin SDK only
      allow read: if isAdmin();
      allow update: if false;     // Immutable
      allow delete: if false;     // Immutable
    }
  }
}