rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return (request.auth.token.admin == true)
        || (request.auth.token.superAdmin == true);
    }

    // Verification documents (NIN slip, proof of income/address, utility bill,
    // guarantor ID). WRITE-ONCE for the same reason as ownership docs below —
    // an approved document is evidence and must be immutable. Previously the
    // path was fixed per docType, so `allow write` (which covers overwrite) let
    // a user swap the bytes of an already-approved document, and annual
    // re-verification destroyed the prior year's file. Each submission now
    // lands on its own timestamped path, so history is retained for admin
    // comparison and nothing approved can be replaced.
    match /verification/{uid}/{docType}/{version} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null;
      allow update, delete: if false;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // Legacy un-versioned verification paths, written by builds before the
    // timestamped scheme. Still readable so existing records resolve, but
    // immutable so an already-approved document can't be swapped out.
    match /verification/{uid}/{docType} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null;
      allow update, delete: if false;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // Ownership documents (C of O / deed) for standalone listings and buildings.
    // Title-level PII — owner and admin read. Bytes are streamed to admins via
    // an authenticated route, never a public/signed URL.
    //
    // WRITE-ONCE. `allow write` also covers overwrite and delete, which defeated
    // the whole ownership-doc integrity rule from outside Firestore: an admin
    // approves the C of O, then the owner PUTs different bytes to the same path.
    // ownershipDocUrl never changes, so no firestore rule fires, and the listing
    // stays 'verified' over a file nobody reviewed. An approved document is
    // evidence — it must be immutable. A new document means a new path (the
    // client already timestamps each upload), which flips the Firestore status
    // back to 'pending' and sends it for review.
    match /ownership/{uid}/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null;
      allow update, delete: if false;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // Tenancy agreements, uploaded by the landlord under their own uid.
    // Direct reads are limited to the uploader (landlord) + admin. The TENANT
    // (a party to the agreement but not the uploader) can't be authorized by a
    // storage rule — rules can't read Firestore to check rental membership — so
    // tenants get the doc via a short-lived signed URL from the
    // getSignedAgreementUrl CF, which verifies membership server-side.
    match /agreements/{uid}/{docId} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // Proof that a disputed payout was actually delivered — typically a
    // screenshot of the bank transfer, uploaded by an ADMIN resolving the
    // dispute. Admin-only both ways: it is our evidence, not the
    // beneficiary's, and the bytes reach the dashboard through the
    // authenticated /api/verification-image route rather than a public URL.
    //
    // Write-once, like every other evidence prefix here. Proof attached to a
    // resolved dispute has to stay the bytes that were reviewed.
    match /payout-proof/{rentalId}/{docId} {
      allow create: if isAdmin() && resource == null;
      allow update, delete: if false;
      allow read: if isAdmin();
    }

    // Move-in and move-out condition media, uploaded under the recorder's own
    // uid. This is what a caution-deposit argument is settled on, so it is
    // write-once: a landlord cannot replace their photos after seeing the
    // tenant's, and a tenant cannot swap a video after a deduction is claimed.
    //
    // The counterparty is a party to the tenancy but not the uploader, and a
    // storage rule cannot read Firestore to check rental membership — the same
    // constraint as agreements above. Cross-party reads therefore go through a
    // signed URL from a callable that verifies membership server-side.
    match /condition/{uid}/{rentalId}/{mediaId} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null;
      allow update, delete: if false;
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}